# Strava API anahtarlariniz. strava.com/settings/api adresinden alinir.
# Bu dosyayi .env olarak kopyalayip degerleri doldurun. .env repoya girmemeli.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Strava uygulamanizda tanimladiginiz callback adresi.
STRAVA_REDIRECT_URI=http://localhost:8080/api/strava/callback
